# SERVER ONLY. Store the real EnvironmentFile outside the repository, mode 0600.
KURT_SAAS_STATE_DIR=/var/lib/kurt-saas
# Set only via a server secret manager or the private EnvironmentFile:
# KURT_SAAS_GROQ_KEY=...
KURT_SAAS_MODEL=openai/gpt-oss-20b
# Native workers remain unavailable until a reviewed digest and runtime exist.
# KURT_SAAS_WORKER_IMAGE=registry.example/kurt-worker@sha256:<reviewed-digest>
# KURT_SAAS_DOCKER_SOCKET=unix:///run/user/1000/docker.sock
