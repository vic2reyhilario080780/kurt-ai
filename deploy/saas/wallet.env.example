# SERVER ONLY. Real credentials belong outside the repo, in a private environment.
KURT_WALLET_STATE_DIR=/var/lib/kurt-wallet
KURT_WALLET_CONFIG=/etc/kurt-wallet/wallet-config.json
# Factory: uvicorn kurt.billing.app:create_app --factory --host 127.0.0.1 --port 8098
# Put an HTTPS reverse proxy in front for remote use. One private control-plane host.
# KURT_WALLET_LOCAL_HTTP=1  # LOOPBACK DEVELOPMENT ONLY; never enable remotely.
# Configure only providers you own/fund. No real values belong in this example.
# KURT_WALLET_OPENROUTER_API_KEY=...
# KURT_WALLET_OPENAI_API_KEY=...
# KURT_WALLET_MISTRAL_API_KEY=...
# KURT_WALLET_DEEPSEEK_API_KEY=...
# KURT_WALLET_GROQ_API_KEY=...
# KURT_WALLET_ANTHROPIC_API_KEY=...
# KURT_WALLET_GOOGLE_AI_KEY=...
# KURT_WALLET_FAL_API_KEY=...
# KURT_WALLET_FAL_BILLING_KEY=...  # optional separate key with billing read permissions
# KURT_WALLET_REPLICATE_API_TOKEN=...
# Payment integration remains OFF until all processor settings are supplied.
# KURT_WALLET_STRIPE_KEY=...
# KURT_WALLET_STRIPE_WEBHOOK_SECRET=...
# KURT_WALLET_STRIPE_LIVE=0  # 0 test events only; 1 live events only, separate state recommended
