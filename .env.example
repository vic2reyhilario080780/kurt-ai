# ============================================================
# KURT — API Keys Configuration
# ============================================================
# Copy this to ~/.kurt/.env and fill in your keys.
# Or just run: kurt setup
# DO NOT commit your actual .env file to git!
# ============================================================

# ✅ PINAKA-IMPORTANT — 1 key = lahat ng AI models!
# Get it FREE at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ✅ FREE — Gemini Flash, 1,500 req/day
# Get it at: https://aistudio.google.com/apikey
GOOGLE_AI_KEY=AIzaSy-your-key-here

# ✅ FREE — LLaMA 3.3 70B + DeepSeek, 14,400 req/day (sobrang bilis!)
# Get it at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# ✅ $2 FREE credits — Best coding AI, $0.014/1M tokens
# Get it at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# 💳 $5 free credits — GPT-4o, DALL-E, Whisper
# Get it at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# 💳 $5 free credits — Claude 3.5 Sonnet/Haiku
# Get it at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ✅ FREE tier — Mistral Large, Codestral
# Get it at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your-key-here

# 💳 $1 free credits — Flux image generation (mabilis!)
# Get it at: https://fal.ai/dashboard/keys
FAL_API_KEY=your-key-here

# 💳 Pay per use — MusicGen, Video AI
# Get it at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your-key-here

# 📦 LOCAL — Walang key needed! Install Ollama para sa offline mode
# Install at: https://ollama.ai
OLLAMA_HOST=http://localhost:11434

# ============================================================
# OPTIONAL: E-Commerce integrations (para sa Shopee/Lazada plugins)
# ============================================================
# SHOPEE_SHOP_ID=your-shop-id
# SHOPEE_API_KEY=your-api-key
# LAZADA_APP_KEY=your-app-key
# LAZADA_APP_SECRET=your-app-secret
